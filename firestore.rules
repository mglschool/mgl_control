rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default safety deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Check if the user is an admin or staff member
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mallawigovlanguageschool@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Grades collection
    match /grades/{gradeId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Assessments collection
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Homeworks collection
    match /homeworks/{homeworkId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Discipline collection
    match /discipline/{disciplineId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // AuditLogs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
